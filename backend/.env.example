# ─── OCR Settings ────────────────────────────────────────────────────────────
# Tesseract language packs (install via: apt install tesseract-ocr-hin tesseract-ocr-tam etc.)
TESSDATA_LANGS=eng+hin

# Set to "true" to use EasyOCR instead of Tesseract (better for regional scripts, needs GPU)
USE_EASYOCR=false

# Resolution (DPI) when converting scanned PDF pages to images for OCR
OCR_DPI=300

# ─── App Settings ─────────────────────────────────────────────────────────────
# Override the SQLite database path (defaults to backend/voter_data.db)
# DATABASE_URL=sqlite:///./voter_data.db
